# ==============================================================
# TRACE: JKLU Money Manager - Environment Configuration Template
# DO NOT PUT REAL API KEYS IN THIS FILE!
# Copy this file to '.env' and fill in your secrets locally.
# When deploying (e.g. Render, Railway, Fly.io), add these as Environment Variables.
# ==============================================================

# Server Port (default 3000)
PORT=3000

# Google Gemini API Key (Recommended - Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Alternative Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
